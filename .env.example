# Copy this file to `.env` (which is gitignored) and fill in the values.
# Source it before running scripts/register_bot.py and before `cdk deploy`:
#   source .env

# --- Discord developer portal values (https://discord.com/developers/applications) ---
# From the app's "General Information" tab:
export DISCORD_APPLICATION_ID=""
export DISCORD_APPLICATION_PUBLIC_KEY=""

# From the app's "Bot" tab (Reset Token to reveal once):
export DISCORD_BOT_TOKEN=""

# (Optional but recommended) From Discord app → Server Settings → Widget → Server ID.
# If set, commands register instantly to this guild only.
# If omitted, commands register globally (can take up to 1 hour to appear).
export DISCORD_GUILD_ID=""

# --- Valheim server settings ---
export SERVER_NAME="Chips Gaming"
export WORLD_NAME="ChipsWorld"
export SERVER_PASSWORD=""  # min 5 chars, required by Valheim

# --- AWS / DNS ---
export AWS_PROFILE="lamda-personal-aws"
export CDK_DEFAULT_REGION="us-west-2"
export DOMAIN_NAME="chipsgaming.click"
export SUBDOMAIN="valheim"
